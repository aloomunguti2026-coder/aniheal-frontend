{
  "redirects": [
    {
      "source": "/clinical-services",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/insurance",
      "destination": "/animal-insurance",
      "permanent": true
    },
    {
      "source": "/partnerships",
      "destination": "/collaborations",
      "permanent": true
    },
    {
      "source": "/book-appointment",
      "destination": "/appointment-booking",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/our-team",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

